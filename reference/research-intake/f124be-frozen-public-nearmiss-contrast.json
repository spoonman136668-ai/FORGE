  "hypothesis": "Counterfactual public edge-contrast evidence, not a CHECK threshold: on unchanged-joint accepted graphs, independently enumerate valid one-bit-tolerant paths, extract every one-bit gap, and compare each gap to other incident publicly decoded edges. Test whether unsupported or contradicted gaps identify source-confirmed one-bit near-miss negatives without deleting genuine tolerated positives. Candidate may only veto, never add acceptance.",
  "policies": [
    "reject_peer_contradicted",
    "reject_peer_unbacked",
    "reject_peer_both"
  ],
  "policy_contract": {
    "reject_peer_contradicted": "Veto iff all 1-bit tolerant target-reaching paths have >=1 mismatch for which a separate publicly decoded same-from same-role peer has src_bits equal to predecessor carry exactly; no graph family flags",
    "reject_peer_unbacked": "Veto iff all tolerant target-reaching paths have >=1 mismatch with zero independent same-from same-role peers whose src_bits match predecessor carry within one bit AND zero other same-to same-role peers whose dst_bits match current edge dst_bits; no graph labels",
    "reject_peer_both": "Veto iff both rejected-by-contradicted and rejected-by-unbacked would veto, using public edges only",
    "path_bounds": {
      "role_depth_min": 7,
      "role_depth_max": 15,
      "edges_min": 12,

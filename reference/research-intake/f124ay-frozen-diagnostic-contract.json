  "hypotheses": [
    {
      "key": "representation",
      "test": "Evaluator-only true inverse third-order GF(2) finite differences over frozen triples. Any nonzero third derivative proves not representable by any quadratic Boolean inverse, regardless of public-information count or fitting algorithm."
    },
    {
      "key": "sparse_capacity",
      "test": "Evaluator-only nonzero second-order finite-difference pair count at origin. More than two distinct interacting output-bit pairs disproves the frozen two-pair inverse class."
    },
    {
      "key": "fitting",
      "test": "For each 48-public condition on same tasks, instrument exactly 256 frozen RANSAC trials; report rank-valid fits, best 40-row inverse-bit residual, 8-row public-check correctness, and full-domain injectivity/abstention in that order. No threshold retuning."
    },
    {
      "key": "information",
      "test": "Compare 48-public and distinct diagnostic 96-public response information on identical TRAIN-FIT tasks under separately declared higher cost. Retain 48 original/active model as equal-budget control; 96 is attribution-only and not an admissible claim of equal-cost improvement."
    },
    {
      "key": "abstention",
      "test": "Separate no-rank, FIT residual >12, CHECK correct <96, and bijection rejection, with per-case tally. Diagnostic relaxed results never produce an accepted prediction or optimizer promotion."
    }
  ],
